# VoteNow - Configuration environnement
# Copier en .env et remplir les valeurs

APP_ENV=production
APP_DEBUG=false
APP_URL=https://votenow.ucad.sn

# Base de données
DB_HOST=localhost
DB_NAME=votenow_db
DB_USER=votenow_user
DB_PASS=CHANGE_THIS_PASSWORD_NOW

# Sécurité
APP_KEY=GENERATE_32_CHARS_RANDOM_KEY_HERE
SESSION_LIFETIME=1800

# Email (optionnel)
MAIL_HOST=smtp.ucad.sn
MAIL_PORT=587
MAIL_USER=noreply@ucad.sn
MAIL_PASS=
MAIL_FROM_NAME=VoteNow
MAIL_ENCRYPTION=tls
