        "paragonie/csrf-magic": "^1.0",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.0",
        "phpmailer/phpmailer": "^6.8",
        "league/csv": "^9.0",
        "symfony/rate-limiter": "^6.0",
